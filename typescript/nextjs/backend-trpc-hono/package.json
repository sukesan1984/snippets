{
  "name": "backend-trpc",
  "version": "1.0.0",
  "description": "Backend API server with tRPC + Hono",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/trpc-server": "^0.3.2",
    "@shared/prisma": "workspace:*",
    "@trpc/server": "^10.45.2",
    "hono": "^4.6.12",
    "superjson": "^2.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
